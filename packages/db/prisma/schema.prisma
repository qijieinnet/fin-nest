  // user | assistant（工具调用中间态不落库，只存对话的可见内容）。
  role           String
  content        String
  // assistant 消息携带的结构化卡片数组（记账草稿/查询结果等），前端按 kind 渲染；
  // 草稿卡确认后回写 status/transactionId，历史回放时显示「已记账」。
  cards          Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

