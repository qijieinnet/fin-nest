// Fin Nest 数据库 schema。
// v1 使用 Prisma + Prisma Migrate；Prisma 难以表达的 PostgreSQL 约束在 migration.sql 中补充。

generator client {
  provider = "prisma-client-js"
  // 生成到包内固定目录，确保 pnpm deploy / Docker 打包能带上生成的 client 与查询引擎。
  output   = "../generated/client"
  // native：本地开发（macOS/当前架构）；
  // debian-*：容器运行时 node:*-slim —— 同时覆盖 amd64 与 arm64，便于在任意架构主机上构建镜像。
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.Citext
  account      String    @unique @db.Citext
  alias        String
  isAdmin      Boolean   @default(false) @map("is_admin")
  passwordHash String    @map("password_hash")
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model AppSetting {
  id                  Int      @id @default(1) @db.SmallInt
  registrationEnabled Boolean  @default(true) @map("registration_enabled")
  updatedBy           String?  @map("updated_by") @db.Uuid
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  deviceName String?   @map("device_name")
  userAgent  String?   @map("user_agent")
  ip         String?   @db.Inet
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model ServiceToken {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  tokenHash  String    @unique @map("token_hash")
  scopes     String[]  @default([])
  allowedIps String[]  @default([]) @map("allowed_ips")
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("service_tokens")
}

model Ledger {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String
  icon                String?
  currency            String    @default("CNY") @db.Char(3)
  amountDecimalPlaces Int       @default(2) @map("amount_decimal_places") @db.SmallInt
  ownerUserId         String    @map("owner_user_id") @db.Uuid
  createdBy           String    @map("created_by") @db.Uuid
  updatedBy           String?   @map("updated_by") @db.Uuid
  deletedBy           String?   @map("deleted_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("ledgers")
}

model LedgerMember {
  id        String    @id @default(uuid()) @db.Uuid
  ledgerId  String    @map("ledger_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      String
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([ledgerId, userId])
  @@index([userId, removedAt])
  @@index([ledgerId, role])
  @@map("ledger_members")
}

model LedgerInvite {
  id        String    @id @default(uuid()) @db.Uuid
  ledgerId  String    @map("ledger_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  createdBy String    @map("created_by") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  usedCount Int       @default(0) @map("used_count")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ledger_invites")
}

model LedgerJoinRequest {
  id              String    @id @default(uuid()) @db.Uuid
  ledgerId        String    @map("ledger_id") @db.Uuid
  inviteId        String?   @map("invite_id") @db.Uuid
  requesterUserId String    @map("requester_user_id") @db.Uuid
  status          String
  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  message         String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ledgerId, status])
  @@index([requesterUserId, status])
  @@map("ledger_join_requests")
}

model RecordSetting {
  ledgerId            String   @id @map("ledger_id") @db.Uuid
  fieldOrder          Json     @map("field_order") @db.JsonB
  visibleFields       Json     @map("visible_fields") @db.JsonB
  acctRequired        Boolean  @default(false) @map("acct_required")
  personRequired      Boolean  @default(false) @map("person_required")
  continuousEntry     Boolean  @default(false) @map("continuous_entry")
  amountDecimalPlaces Int      @default(2) @map("amount_decimal_places") @db.SmallInt
  updatedBy           String?  @map("updated_by") @db.Uuid
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("record_settings")
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  ledgerId   String    @map("ledger_id") @db.Uuid
  type       String
  name       String
  icon       String?
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([ledgerId, type, name])
  @@index([ledgerId, type, archivedAt])
  @@map("categories")
}

model Subcategory {
  id         String    @id @default(uuid()) @db.Uuid
  ledgerId   String    @map("ledger_id") @db.Uuid
  categoryId String    @map("category_id") @db.Uuid
  name       String
  icon       String?
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([categoryId, name])
  @@index([categoryId, archivedAt])
  @@map("subcategories")
}

model Person {
  id         String    @id @default(uuid()) @db.Uuid
  ledgerId   String    @map("ledger_id") @db.Uuid
  name       String
  icon       String?
  isDefault  Boolean   @default(false) @map("is_default")
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([ledgerId, name])
  @@index([ledgerId, archivedAt])
  @@map("people")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  ledgerId              String    @map("ledger_id") @db.Uuid
  type                  String
  name                  String
  icon                  String?
  balanceMicros         BigInt    @default(0) @map("balance_micros")
  includeInNetWorth     Boolean   @default(true) @map("include_in_net_worth")
  // 同一分类内的手动排序序号，列表按其升序排列。
  sortOrder             Int       @default(0) @map("sort_order")
  creditLimitMicros     BigInt?   @map("credit_limit_micros")
  investmentCostMicros  BigInt?   @map("investment_cost_micros")
  counterparty          String?
  dueDate               DateTime? @map("due_date") @db.Date
  billDay               Int?      @map("bill_day") @db.SmallInt
  repayDay              Int?      @map("repay_day") @db.SmallInt
  settledAt             DateTime? @map("settled_at") @db.Timestamptz(6)
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy             String?   @map("created_by") @db.Uuid
  updatedBy             String?   @map("updated_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ledgerId, type, archivedAt])
  @@map("accounts")
}

model SubAccount {
  id                String    @id @default(uuid()) @db.Uuid
  ledgerId          String    @map("ledger_id") @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  name              String
  icon              String?
  balanceMicros     BigInt    @default(0) @map("balance_micros")
  includeInNetWorth Boolean   @default(true) @map("include_in_net_worth")
  // 同一账户内子账户的手动排序序号，列表按其升序排列。
  sortOrder         Int       @default(0) @map("sort_order")
  // 默认子账户：money 账户创建时自动生成、承接未指定子账户的记账，不可删除、无“设为默认”动作。
  isDefault         Boolean   @default(false) @map("is_default")
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 同一账户内“活跃”子账户名唯一：归档（archivedAt 非空）的行不参与唯一性，
  // 允许把子账户改名成已删除子账户的名字。Prisma 无法表达部分唯一索引，
  // 由迁移 25 手写的 partial unique index (WHERE archived_at IS NULL) 保证。
  @@index([accountId, archivedAt])
  @@map("sub_accounts")
}

model AccountAdjustment {
  id                  String   @id @default(uuid()) @db.Uuid
  ledgerId            String   @map("ledger_id") @db.Uuid
  accountId           String   @map("account_id") @db.Uuid
  subAccountId        String?  @map("sub_account_id") @db.Uuid
  balanceBeforeMicros BigInt   @map("balance_before_micros")
  balanceAfterMicros  BigInt   @map("balance_after_micros")
  deltaMicros         BigInt   @map("delta_micros")
  note                String?
  createdBy           String   @map("created_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("account_adjustments")
}

model Transaction {
  id                    String    @id @default(uuid()) @db.Uuid
  ledgerId              String    @map("ledger_id") @db.Uuid
  type                  String
  grossAmountMicros     BigInt    @map("gross_amount_micros")
  effectiveAmountMicros BigInt    @map("effective_amount_micros")
  currency              String    @default("CNY") @db.Char(3)
  occurredOn            DateTime  @map("occurred_on") @db.Date
  occurredAt            DateTime  @map("occurred_at") @db.Timestamptz(6)
  categoryId            String?   @map("category_id") @db.Uuid
  subcategoryId         String?   @map("subcategory_id") @db.Uuid
  categorySnapshot      Json?     @map("category_snapshot") @db.JsonB
  personId              String?   @map("person_id") @db.Uuid
  personSnapshot        Json?     @map("person_snapshot") @db.JsonB
  accountId             String?   @map("account_id") @db.Uuid
  subAccountId          String?   @map("sub_account_id") @db.Uuid
  fromAccountId         String?   @map("from_account_id") @db.Uuid
  fromSubAccountId      String?   @map("from_sub_account_id") @db.Uuid
  toAccountId           String?   @map("to_account_id") @db.Uuid
  toSubAccountId        String?   @map("to_sub_account_id") @db.Uuid
  note                  String?
  source                String    @default("manual")
  sourceId              String?   @map("source_id") @db.Uuid
  createdBy             String    @map("created_by") @db.Uuid
  updatedBy             String?   @map("updated_by") @db.Uuid
  deletedBy             String?   @map("deleted_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([ledgerId, occurredOn(sort: Desc)])
  @@index([ledgerId, type, occurredOn(sort: Desc)])
  @@index([ledgerId, categoryId])
  @@index([ledgerId, personId])
  @@index([ledgerId, createdBy])
  @@index([accountId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("transactions")
}

model AccountEntry {
  id                  String   @id @default(uuid()) @db.Uuid
  ledgerId            String   @map("ledger_id") @db.Uuid
  accountId           String   @map("account_id") @db.Uuid
  subAccountId        String?  @map("sub_account_id") @db.Uuid
  entryType           String   @map("entry_type")
  amountDeltaMicros   BigInt   @map("amount_delta_micros")
  balanceBeforeMicros BigInt   @map("balance_before_micros")
  balanceAfterMicros  BigInt   @map("balance_after_micros")
  transactionId       String?  @map("transaction_id") @db.Uuid
  adjustmentId        String?  @map("adjustment_id") @db.Uuid
  relatedAccountId    String?  @map("related_account_id") @db.Uuid
  note                String?
  occurredAt          DateTime @map("occurred_at") @db.Timestamptz(6)
  createdBy           String?  @map("created_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ledgerId, accountId, occurredAt(sort: Desc)])
  @@index([transactionId])
  @@index([adjustmentId])
  @@map("account_entries")
}

model TransactionAccountRelation {
  id            String   @id @default(uuid()) @db.Uuid
  ledgerId      String   @map("ledger_id") @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  relationKind  String   @map("relation_kind")
  amountMicros  BigInt   @map("amount_micros")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("transaction_account_relations")
}

model TransactionLink {
  id            String   @id @default(uuid()) @db.Uuid
  ledgerId      String   @map("ledger_id") @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  linkedType    String   @map("linked_type")
  linkedId      String   @map("linked_id") @db.Uuid
  linkKind      String   @default("related") @map("link_kind")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([transactionId, linkedType, linkedId])
  @@index([ledgerId, linkedType, linkedId])
  @@map("transaction_links")
}

model AutoRule {
  id               String    @id @default(uuid()) @db.Uuid
  ledgerId         String    @map("ledger_id") @db.Uuid
  enabled          Boolean   @default(true)
  type             String
  amountMicros     BigInt    @map("amount_micros")
  categoryId       String?   @map("category_id") @db.Uuid
  subcategoryId    String?   @map("subcategory_id") @db.Uuid
  accountId        String?   @map("account_id") @db.Uuid
  subAccountId     String?   @map("sub_account_id") @db.Uuid
  fromAccountId    String?   @map("from_account_id") @db.Uuid
  fromSubAccountId String?   @map("from_sub_account_id") @db.Uuid
  toAccountId      String?   @map("to_account_id") @db.Uuid
  toSubAccountId   String?   @map("to_sub_account_id") @db.Uuid
  personId         String?   @map("person_id") @db.Uuid
  note             String?
  relationPayload  Json?     @map("relation_payload") @db.JsonB
  insuranceId      String?   @map("insurance_id") @db.Uuid
  itemId           String?   @map("item_id") @db.Uuid
  subscriptionId   String?   @map("subscription_id") @db.Uuid
  repeatRule       String    @map("repeat_rule")
  startDate        DateTime  @map("start_date") @db.Date
  nextRunOn        DateTime? @map("next_run_on") @db.Date
  createdBy        String    @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)

  @@map("auto_rules")
}

model AutoPendingTransaction {
  id                     String    @id @default(uuid()) @db.Uuid
  ledgerId               String    @map("ledger_id") @db.Uuid
  autoRuleId             String    @map("auto_rule_id") @db.Uuid
  periodKey              String    @map("period_key")
  scheduledFor           DateTime  @map("scheduled_for") @db.Date
  status                 String
  type                   String
  amountMicros           BigInt    @map("amount_micros")
  categoryId             String?   @map("category_id") @db.Uuid
  subcategoryId          String?   @map("subcategory_id") @db.Uuid
  accountId              String?   @map("account_id") @db.Uuid
  subAccountId           String?   @map("sub_account_id") @db.Uuid
  fromAccountId          String?   @map("from_account_id") @db.Uuid
  fromSubAccountId       String?   @map("from_sub_account_id") @db.Uuid
  toAccountId            String?   @map("to_account_id") @db.Uuid
  toSubAccountId         String?   @map("to_sub_account_id") @db.Uuid
  personId               String?   @map("person_id") @db.Uuid
  note                   String?
  relationPayload        Json?     @map("relation_payload") @db.JsonB
  insuranceId            String?   @map("insurance_id") @db.Uuid
  itemId                 String?   @map("item_id") @db.Uuid
  subscriptionId         String?   @map("subscription_id") @db.Uuid
  confirmedTransactionId String?   @map("confirmed_transaction_id") @db.Uuid
  confirmedBy            String?   @map("confirmed_by") @db.Uuid
  confirmedAt            DateTime? @map("confirmed_at") @db.Timestamptz(6)
  deletedBy              String?   @map("deleted_by") @db.Uuid
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)
  updatedBy              String?   @map("updated_by") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([autoRuleId, periodKey])
  @@index([ledgerId, status, scheduledFor])
  @@map("auto_pending_transactions")
}

model QuickTemplate {
  id               String    @id @default(uuid()) @db.Uuid
  ledgerId         String    @map("ledger_id") @db.Uuid
  type             String
  name             String?
  amountMicros     BigInt?   @map("amount_micros")
  categoryId       String?   @map("category_id") @db.Uuid
  subcategoryId    String?   @map("subcategory_id") @db.Uuid
  accountId        String?   @map("account_id") @db.Uuid
  subAccountId     String?   @map("sub_account_id") @db.Uuid
  fromAccountId    String?   @map("from_account_id") @db.Uuid
  fromSubAccountId String?   @map("from_sub_account_id") @db.Uuid
  toAccountId      String?   @map("to_account_id") @db.Uuid
  toSubAccountId   String?   @map("to_sub_account_id") @db.Uuid
  personId         String?   @map("person_id") @db.Uuid
  note             String?
  relationPayload  Json?     @map("relation_payload") @db.JsonB
  insuranceId      String?   @map("insurance_id") @db.Uuid
  itemId           String?   @map("item_id") @db.Uuid
  subscriptionId   String?   @map("subscription_id") @db.Uuid
  directEnabled    Boolean   @default(false) @map("direct_enabled")
  sortOrder        Int       @default(0) @map("sort_order")
  createdBy        String    @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)

  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("quick_templates")
}

model Plan {
  id                String    @id @default(uuid()) @db.Uuid
  ledgerId          String    @map("ledger_id") @db.Uuid
  kind              String
  metric            String
  name              String
  limitAmountMicros BigInt?   @map("limit_amount_micros")
  limitCount        Int?      @map("limit_count")
  startDate         DateTime  @map("start_date") @db.Date
  repeatRule        String    @map("repeat_rule")
  matchRule         Json?     @map("match_rule") @db.JsonB
  foresightEnabled  Boolean   @default(false) @map("foresight_enabled")
  createdBy         String    @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  stoppedAt         DateTime? @map("stopped_at") @db.Timestamptz(6)
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)

  @@index([ledgerId, stoppedAt, archivedAt])
  @@map("plans")
}

model PlanShareToken {
  id         String    @id @default(uuid()) @db.Uuid
  planId     String    @map("plan_id") @db.Uuid
  ledgerId   String    @map("ledger_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
