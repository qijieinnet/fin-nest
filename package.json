{
  "name": "fin-nest",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" -r run build",
    "build": "pnpm -r run build",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @fin-nest/db run generate",
    "db:migrate": "pnpm --filter @fin-nest/db run migrate:dev",
    "db:deploy": "pnpm --filter @fin-nest/db run migrate:deploy",
    "e2e:api": "pnpm --filter @fin-nest/api run e2e",
    "e2e:system-backup": "pnpm build:packages && node scripts/e2e-system-backup-isolated.mjs",
    "dev": "pnpm build:packages && pnpm --parallel --filter @fin-nest/api --filter @fin-nest/web run dev",
    "dev:api": "pnpm build:packages && pnpm --filter @fin-nest/api run dev",
    "dev:web": "pnpm build:packages && pnpm --filter @fin-nest/web run dev",
    "dev:worker": "pnpm build:packages && pnpm --filter @fin-nest/worker run dev",
    "db:studio": "pnpm --filter @fin-nest/db run studio",
    "infra:up": "docker compose -f infra/compose/docker-compose.dev.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/compose/docker-compose.dev.yml down",
    "check:compose": "node scripts/check-compose-consistency.mjs",
    "compose:up": "docker compose --env-file .env.docker up -d",
    "compose:pull": "docker compose --env-file .env.docker pull",
    "compose:logs": "docker compose --env-file .env.docker logs -f",
    "compose:down": "docker compose --env-file .env.docker down",
    "docker:build": "docker compose -f infra/compose/docker-compose.prod.yml --env-file .env.docker build",
    "docker:up": "docker compose -f infra/compose/docker-compose.prod.yml --env-file .env.docker up -d --build",
    "docker:down": "docker compose -f infra/compose/docker-compose.prod.yml --env-file .env.docker down",
    "docker:logs": "docker compose -f infra/compose/docker-compose.prod.yml --env-file .env.docker logs -f"
  },
  "devDependencies": {
    "js-yaml": "^5.2.1",
    "prettier": "^3.8.5",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp"
    ]
  }
}
