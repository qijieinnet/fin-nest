# Docker / Compose 部署用环境变量。复制为 .env.docker 后按需修改：
#   cp .env.docker.example .env.docker
#   docker compose -f infra/compose/docker-compose.prod.yml --env-file .env.docker up -d --build
# 注意：这些是运行时机密，不要提交进仓库。

# --- Compose 内置基础设施开关 ---
# 保持 bundled：由 compose 一并启动内置 postgres + minio。
# 置空（COMPOSE_PROFILES=）则不启动内置服务，改用下方外部 DATABASE_URL / MINIO_*。
COMPOSE_PROFILES=bundled

# --- 对外端口 ---
WEB_PORT=4001
API_EXPOSE_PORT=4000

# --- App ---
# 允许访问的 web 来源（浏览器地址，多个用逗号分隔）。反代/域名部署时改成真实来源。
WEB_ORIGIN=http://localhost:4001
APP_TIMEZONE=Asia/Shanghai
WORKER_POLL_INTERVAL_MS=30000
# 前面有 nginx 等可信反代时置 true（客户端 IP 取 X-Forwarded-For）；
# API 端口直接对外（默认暴露 API_EXPOSE_PORT）时保持 false，否则 XFF 可伪造、登录限速会被绕过。
TRUST_PROXY=false

# --- PostgreSQL（内置 postgres 使用；用外部库时改 DATABASE_URL 指向外部即可）---
POSTGRES_USER=finnest
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=finnest
# 内置库：主机名用 compose 服务名 postgres。外部库：替换为外部连接串。
# 已有数据的库也安全：迁移只 apply 未执行项，不会清空。
DATABASE_URL=postgresql://finnest:change-me-please@postgres:5432/finnest?schema=public

# --- MinIO / 对象存储 ---
# 内置 minio：端点用服务名 minio。外部 S3/MinIO：改成外部端点与凭证。
# 注意：production 下 MINIO_SECRET_KEY 必须改成强密钥（保留 minioadmin / change-me-please 会拒绝启动）。
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-please
MINIO_BUCKET=fin-nest

# --- Web ---
# 浏览器同源请求前缀；容器内 Next 会把 /api 转发到 api 服务（API_INTERNAL_URL）。
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_ENABLE_DEV_UI=false
# web 容器在内网转发 /api 的目标（一般无需改）。
API_INTERNAL_URL=http://api:4000
