# Docker / Compose 部署用环境变量。复制为 .env.docker 后按需修改：
#   cp .env.docker.example .env.docker
#
# 拉取预构建镜像部署（推荐，无需本地构建）：
#   docker compose --env-file .env.docker up -d
# 从源码构建部署（开发/改代码）：
#   docker compose -f infra/compose/docker-compose.prod.yml --env-file .env.docker up -d --build
#
# 注意：这些是运行时机密，不要提交进仓库。

# --- 镜像版本（仅拉取预构建镜像时生效）---
# latest 跟随最新发布；生产建议钉具体版本，升级可控、可回滚。
# 注意不带 v 前缀：git tag 是 v1.2.0，对应的镜像 tag 是 1.2.0（也可只钉次版本 1.2）。
FIN_NEST_VERSION=latest

# --- Compose 内置基础设施开关 ---
# 保持 bundled：由 compose 一并启动内置 postgres + minio。
# 置空（COMPOSE_PROFILES=）则不启动内置服务，改用下方外部 DATABASE_URL / MINIO_*。
COMPOSE_PROFILES=bundled

# --- 对外端口 ---
# 只有 web 需要对外；API 由 web 容器在 docker 网络内访问，不依赖发布端口。
WEB_PORT=4001
API_EXPOSE_PORT=4000
# API 发布端口绑定的网卡。默认 127.0.0.1（仅宿主机可访问，便于 curl 调试 / nginx 反代）。
# 确需从其他机器直连 API 才改成 0.0.0.0——那样 API 直接对外，
# 必须同时保持 TRUST_PROXY=false，否则 XFF 可伪造、登录限速会被绕过。
API_EXPOSE_BIND=127.0.0.1

# --- App ---
# 允许访问的 web 来源（浏览器地址，多个用逗号分隔）。反代/域名部署时改成真实来源。
WEB_ORIGIN=http://localhost:4001
APP_TIMEZONE=Asia/Shanghai
WORKER_POLL_INTERVAL_MS=30000
# 前面有 nginx 等可信反代时置 true（客户端 IP 取 X-Forwarded-For）；
# API 端口直接对外（默认暴露 API_EXPOSE_PORT）时保持 false，否则 XFF 可伪造、登录限速会被绕过。
TRUST_PROXY=false

# --- PostgreSQL（内置 postgres 使用；用外部库时改 DATABASE_URL 指向外部即可）---
POSTGRES_USER=finnest
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=finnest
# 内置库：主机名用 compose 服务名 postgres。外部库：替换为外部连接串。
# 已有数据的库也安全：迁移只 apply 未执行项，不会清空。
DATABASE_URL=postgresql://finnest:change-me-please@postgres:5432/finnest?schema=public

# --- MinIO / 对象存储 ---
# 内置 minio：端点用服务名 minio。外部 S3/MinIO：改成外部端点与凭证。
# 注意：production 下 MINIO_SECRET_KEY 必须改成强密钥（保留 minioadmin / change-me-please 会拒绝启动）。
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-please
MINIO_BUCKET=fin-nest

# --- Web ---
# 浏览器同源请求前缀；容器内 Next 会把 /api 转发到 api 服务（API_INTERNAL_URL）。
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_ENABLE_DEV_UI=false
# web 容器在内网转发 /api 的目标（一般无需改）。
API_INTERNAL_URL=http://api:4000

# --- AI 助手（可选）---
# 三者都填才启用；OpenAI-compatible /chat/completions 协议，
# 可指向 DeepSeek / 通义 / 本地 Ollama 等。留空则相关端点返回未启用、前端隐藏入口。
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=sk-xxx
# AI_MODEL=deepseek-chat

# --- 飞书机器人（可选）---
# 两者必须同时填，只填一个会启动报错（这是刻意的：只配一半是典型漏配）。
# 走长连接，不需要公网回调地址，因而也不需要 Encrypt Key / Verification Token。
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
