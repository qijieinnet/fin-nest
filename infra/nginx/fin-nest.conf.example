# fin-nest 线上前置 nginx 示例：同一域名下 /api 转发到 API 服务，其余转发到 Next。
# 复制到 /etc/nginx/conf.d/ 后按实际域名、端口、证书调整。
server {
    listen 80;
    server_name fin-nest.example.com;

    # /api/xxx -> API 服务（proxy_pass 结尾的 / 会去掉 /api 前缀，
    # 即 /api/auth/login -> /auth/login，与后端路由一致）。
    location /api/ {
        proxy_pass http://127.0.0.1:4000/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 附件等大请求体
        client_max_body_size 50m;
    }

    # 其余请求 -> Next（next start，端口与 apps/web 启动参数保持一致）。
    location / {
        proxy_pass http://127.0.0.1:4001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Next dev/HMR 及未来可能的 WebSocket
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
