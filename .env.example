# 复制为 .env 后使用；不要把真实密钥提交进仓库。

# --- App ---
NODE_ENV=development
API_PORT=4000
# 允许跨域访问 API 的 web 来源（多个用逗号分隔）
WEB_ORIGIN=http://localhost:4001
# “今天/本月”按此时区计算（IANA 时区名），影响统计默认月份与自动记账生成时点
APP_TIMEZONE=Asia/Shanghai
# worker 常驻轮询间隔（毫秒）；自动记账生成、文件删除重试依赖 worker 持续运行
WORKER_POLL_INTERVAL_MS=30000
# API 前面有可信反向代理（nginx 等）时置 true：客户端 IP 取 X-Forwarded-For。
# API 直接对外时保持 false，否则 XFF 可伪造、登录限速会被绕过。
TRUST_PROXY=false

# --- PostgreSQL ---
POSTGRES_USER=finnest
POSTGRES_PASSWORD=finnest
POSTGRES_DB=finnest
DATABASE_URL=postgresql://finnest:finnest@localhost:5432/finnest?schema=public

# --- MinIO ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fin-nest

# --- Web (仅 NEXT_PUBLIC_* 暴露给浏览器) ---
# 同源 API 前缀：开发由 Next rewrites 转发到 API_PORT，线上由前置 nginx 转发。
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_ENABLE_DEV_UI=true
