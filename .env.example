# 复制为 .env 后使用；不要把真实密钥提交进仓库。

# --- App ---
NODE_ENV=development
API_PORT=4000
# 允许跨域访问 API 的 web 来源（多个用逗号分隔）
WEB_ORIGIN=http://localhost:4001
# “今天/本月”按此时区计算（IANA 时区名），影响统计默认月份与自动记账生成时点
APP_TIMEZONE=Asia/Shanghai
# 应用锁 Face ID / Touch ID 的 WebAuthn RP ID，不配时取 WEB_ORIGIN 第一项的 hostname。
# 只有 WEB_ORIGIN 配了多个不同域名时才需要显式指定；改动会让已注册的凭证全部失效。
# APP_LOCK_RP_ID=fin.example.com
# worker 常驻轮询间隔（毫秒）；自动记账生成、文件删除重试依赖 worker 持续运行
WORKER_POLL_INTERVAL_MS=30000
# API 前面有可信反向代理（nginx 等）时置 true：客户端 IP 取 X-Forwarded-For。
# API 直接对外时保持 false，否则 XFF 可伪造、登录限速会被绕过。
TRUST_PROXY=false

# --- PostgreSQL ---
POSTGRES_USER=finnest
POSTGRES_PASSWORD=finnest
POSTGRES_DB=finnest
DATABASE_URL=postgresql://finnest:finnest@localhost:5432/finnest?schema=public

# --- MinIO ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fin-nest

# --- 系统备份（管理员功能 › 自动备份）---
# 归档落盘目录，相对路径按进程工作目录解析。本地开发默认落在仓库根的 data/backups。
BACKUP_DIR=./data/backups

# --- AI Agent（可选，三项都配置才启用；可指 DeepSeek/通义/本地 Ollama/OpenAI 等）---
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=sk-xxx
# AI_MODEL=deepseek-chat
# 上游协议：chat = /chat/completions（默认），responses = OpenAI Responses API /responses。
# 不填时按 AI_BASE_URL 末段推断（以 /responses 结尾走 Responses）；
# 网关只提供 Responses API 而 base url 写成 /v1 时，需要在这里显式指定。
# AI_PROTOCOL=responses

# --- AI 联网搜索（可选，AI Agent的扩展能力）---
# 配置后 AI 多出 web_search 工具：能查最新机型、当前售价、二手行情等账本里没有的信息，
# 配合「我想换手机」这类花钱决策使用。不配则该工具不下发，AI 其余能力不受影响。
# 刻意只支持固定端点的搜索服务、不做任意网页抓取（自部署常在内网，等于放开 SSRF）。
#   bocha   博查 AI 搜索，国内直连、中文商品价格结果好 → 需 SEARCH_API_KEY
#   tavily  Tavily，海外通用 → 需 SEARCH_API_KEY
#   searxng 自建 SearXNG，零 key、查询不外泄 → 需 SEARCH_BASE_URL，
#           且实例 settings.yml 要有 search.formats: [html, json]
# SEARCH_PROVIDER=bocha
# SEARCH_API_KEY=sk-xxx
# SEARCH_BASE_URL=http://searxng:8080
# 单次搜索回传给模型的条数（1~10，默认 5），调大会线性推高 token 成本。
# SEARCH_MAX_RESULTS=5

# --- 飞书机器人（可选，两项都配置才启用；长连接形态，无需公网回调地址）---
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx

# --- Web Push / PWA 通知（可选，三项都配置才启用）---
# 生成密钥：pnpm gen:vapid
# VAPID_SUBJECT 必须是 mailto: 或 https:// 开头，其它格式 Apple 的推送服务直接返回 403。
# iPhone 需把站点「添加到主屏幕」后从主屏图标打开；站点必须是有效证书的 HTTPS。
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- Web (仅 NEXT_PUBLIC_* 暴露给浏览器) ---
# 同源 API 前缀：开发由 Next rewrites 转发到 API_PORT，线上由前置 nginx 转发。
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_ENABLE_DEV_UI=true
